@startuml
left to right direction
skinparam packageStyle rectangle

actor "Donor Partner" as Donor
actor "Shelter Coordinator" as Shelter
actor "Notification Service" as Notify

rectangle "Food Bank Surplus Redistribution Platform" {
  usecase "UC-01\nRegister / Verify Partner" as UC1
  usecase "UC-02\nPost Surplus Food Batch" as UC2
  usecase "UC-03\nBrowse Available Batches" as UC3
  usecase "UC-04\nReserve Pickup Window" as UC4
  usecase "UC-05\nView Reservation &\nVerification Code" as UC5
  usecase "UC-06\nMark Batch Expired" as UC6
  usecase "UC-07\nSend Nearby Shelter\nNotification" as UC7
  usecase "UC-08\nValidate Food Details" as UC8
  usecase "UC-09\nVerify Shelter Eligibility" as UC9
}

Donor -- UC1
Donor -- UC2
Donor -- UC5
Donor -- UC6

Shelter -- UC1
Shelter -- UC3
Shelter -- UC4
Shelter -- UC5

Notify -- UC7

UC2 ..> UC8 : <<include>>
UC4 ..> UC9 : <<include>>
UC7 ..> UC2 : <<extend>>\n[high quantity + perishable]

@enduml
